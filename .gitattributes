# Everything that ends up on the server keeps LF, regardless of who checked it
# out. These files are uploaded to an Apache/PHP host, not run from Windows.
*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf

# PowerShell stays CRLF: it only ever runs here.
*.ps1   text eol=crlf

# The fixture database is a SQLite file.
*.ramses binary
